  <property name="windowTitle">
   <string>My Statistics — SenyaSabi</string>
  </property>
  <property name="styleSheet">
   <string notr="true">
QWidget#Dashboard { background-color: #C2D076; }
QFrame#titlePanel, QFrame#streakPanel, QFrame#statCard, QFrame#chartPanel {
    background-color: #F5E5CF;
    border: 2px solid #704833;
    border-radius: 18px;
}
QLabel { color: #0f3a0f; }
QLabel#titleLabel { font-size: 28px; font-weight: 800; }
QLabel#lblCurrentStreak { font-size: 19px; font-weight: 800; }
QLabel#statTitle { font-size: 13px; font-weight: 700; }
QLabel#lblLessonsCompleted, QLabel#lblTotalQuizScore, QLabel#lblModuleCount,
QLabel#lblLatestBadge, QLabel#lblMinigamesCompleted, QLabel#lblLeaderboardRank {
    color: #704833;
    font-size: 22px;
    font-weight: 800;
}
QLabel#imgStatsChart {
    background-color: #E8D7BA;
    border: 2px dashed #704833;
    border-radius: 12px;
    color: #704833;
    font-size: 13px;
}
QLabel.imagePlaceholder {
    background-color: #C2D076;
    border: 2px dashed #704833;
    border-radius: 40px;
    color: #704833;
    font-size: 10px;
}
QPushButton {
    background-color: #0f3a0f;
    color: #F5E5CF;
    border: 1px solid #704833;
    border-radius: 10px;
    padding: 6px 12px;
    font-weight: 700;
}
QPushButton:hover { background-color: #123f12; border-color: #704833; }
QPushButton#btnMenu { min-width: 36px; min-height: 32px; font-size: 18px; padding: 0; }
QPushButton#btnBack { background-color: transparent; color: #0f3a0f; }
QPushButton#btnLeaderboard { background-color: #704833; padding: 5px 8px; }
   </string>
