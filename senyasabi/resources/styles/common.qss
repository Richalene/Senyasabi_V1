QDialog#cameraSetupDialog { background: #c5d27b; color: #704833; font-family: "Segoe UI"; font-size: 15px; }
QDialog#cameraSetupDialog QScrollArea, QDialog#cameraSetupDialog QStackedWidget,
QDialog#cameraSetupDialog QScrollArea > QWidget, QDialog#cameraSetupDialog QStackedWidget > QWidget { background: transparent; border: none; }
QLabel { color: #704833; background: transparent; }
QLabel[class="pageTitle"] { font-size: 26px; font-weight: 700; }
QLabel[class="bodyText"] { font-size: 15px; padding: 8px; }
QLabel#cameraPreview { background: #fff9e9; border: 2px solid #8fa552; border-radius: 20px; padding: 8px; }
QPushButton { background: #fff9e9; color: #704833; border: 1px solid #a39b68; border-radius: 16px; min-height: 28px; padding: 7px 14px; font-weight: 600; }
QPushButton:hover { background: #fff0b8; border-color: #80984d; }
QPushButton:pressed { background: #eadba8; }
QPushButton[class="primaryButton"] { background: #526536; color: #fff9e9; border-color: #526536; }
QPushButton[class="primaryButton"]:hover { background: #687d43; }
QPushButton:disabled { background: #b9be98; color: #6d735a; border-color: #b9be98; }
QPushButton[class="quietButton"] { background: transparent; border: none; font-size: 12px; min-height: 18px; }
QComboBox, QLineEdit { background: #fff9e9; color: #704833; border: 1px solid #a39b68; border-radius: 12px; padding: 8px 12px; min-height: 24px; }
QComboBox QAbstractItemView { background: #fff9e9; color: #704833; selection-background-color: #e8d99e; }
