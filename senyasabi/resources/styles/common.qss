QDialog#cameraSetupDialog {
    background-color: #C2D076;
    color: #4F3222;
    font-family: 'Segoe UI', sans-serif;
}
QDialog#cameraSetupDialog QScrollArea,
QDialog#cameraSetupDialog QStackedWidget,
QDialog#cameraSetupDialog QScrollArea > QWidget,
QDialog#cameraSetupDialog QStackedWidget > QWidget {
    background: transparent;
    border: none;
}
QLabel {
    color: #4F3222;
    background: transparent;
}
QLabel[class="pageTitle"] {
    font-family: 'Cherry Bomb One', 'Segoe UI', cursive, sans-serif;
    font-size: 34px;
    font-weight: bold;
    color: #55331B;
}
QLabel[class="bodyText"] {
    font-family: 'Segoe UI', sans-serif;
    font-size: 17px;
    color: #55331B;
    padding: 2px 4px;
}
QLabel#cameraPreview {
    background-color: #FAFFDC;
    border: 3.5px solid #8FA552;
    border-radius: 28px;
    padding: 10px;
}
QPushButton {
    background-color: #FFFDF0;
    color: #4F3222;
    border: 2px solid #D5C9A9;
    border-radius: 25px;
    min-height: 48px;
    padding: 8px 20px;
    font-family: 'Segoe UI', sans-serif;
    font-size: 16px;
    font-weight: 700;
}
QPushButton:hover {
    background-color: #FFF3BD;
    border-color: #B5A67C;
}
QPushButton:pressed {
    background-color: #EADBA8;
}
QPushButton[class="primaryButton"] {
    background-color: #8C9F3E;
    color: #FFFFFF;
    border: none;
}
QPushButton[class="primaryButton"]:hover {
    background-color: #9DB446;
}
QPushButton[class="primaryButton"]:pressed {
    background-color: #788934;
}
QPushButton:disabled {
    background-color: #CAD5A5;
    color: #8C9670;
    border: none;
}
QPushButton[class="quietButton"] {
    background: transparent;
    border: none;
    color: #6B4E38;
    font-size: 15px;
    font-weight: 600;
    text-decoration: underline;
    min-height: 28px;
}
QPushButton[class="quietButton"]:hover {
    color: #3D2515;
}
QComboBox {
    background-color: #FFFDF0;
    color: #4F3222;
    border: 2.5px solid #D5C9A9;
    border-radius: 22px;
    padding: 8px 18px;
    min-height: 44px;
    font-family: 'Segoe UI', sans-serif;
    font-size: 16px;
    font-weight: 600;
}
QComboBox:focus, QComboBox:hover {
    border-color: #FFAE00;
}
QComboBox::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 36px;
    border-left: none;
}
QComboBox QAbstractItemView {
    background-color: #FFFDF0;
    color: #4F3222;
    selection-background-color: #FFDE59;
    selection-color: #4F3222;
    border: 2px solid #D5C9A9;
    border-radius: 12px;
    padding: 6px;
}

/* Global Tooltip Styling */
QToolTip {
    background-color: #2F4858;
    color: #FFFDF0;
    border: none;
    border-radius: 8px;
    padding: 6px 12px;
    font-family: 'Segoe UI', sans-serif;
    font-size: 14px;
    font-weight: 600;
}
