# SenyaSabi Distributed Client Configuration
# This file is a template for building distributed clients
# Copy this to .env and fill in your Supabase credentials

# --- Client Mode ---
# Set to "distributed" for client builds that connect directly to Supabase
# Set to "fastapi" for development with local FastAPI backend
SYSTEM_MODE=distributed

# --- Supabase Configuration (PUBLIC - safe to bundle) ---
# These are public credentials required for distributed client
# Get these from your Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# --- FastAPI Configuration (Optional) ---
# Only needed if SYSTEM_MODE=fastapi or for admin scripts
# FASTAPI_HOST=127.0.0.1
# FASTAPI_PORT=8000
# FASTAPI_DEBUG=false

# --- SQLite Cache Path (Optional) ---
# Override default SQLite database location
# SENYASABI_DB=
# SENYASABI_MEDIA_CACHE=

# NOTE: The following credentials are NEVER bundled with distributed builds:
# - DATABASE_URL (PostgreSQL connection string)
# - SUPABASE_SERVICE_ROLE_KEY (admin access)
# - SUPABASE_JWT_SECRET (token signing)
# - S3_* (Storage admin credentials)
